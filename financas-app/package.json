{
  "name": "financas-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.16",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-sharing": "~58.0.21",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "lint": "expo lint",
    "build:web": "expo export --platform web --output-dir dist-web && node scripts/postbuild-web.mjs",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node22 --outfile=dist-server/index.js --external:pg-native --minify-syntax --log-level=warning",
    "start:server": "node dist-server/index.js",
    "test:server": "vitest run server"
  },
  "private": true
}
